VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Configuración del Cajón Monedero
# Nombre de la impresora Epson (opcional - se detecta automáticamente)
# Ejemplos: "Generic / Text Only (Copiar 1)", "Epson TM-T20II"
VITE_DRAWER_PRINTER_NAME=Generic / Text Only (Copiar 1)

# Habilitar modo debug del plugin Vite
# true = muestra logs en consola del servidor Vite
# false = sin logs (recomendado en producción)
VITE_DRAWER_DEBUG=false

# URL del servicio local de cajón (PC de la caja con npm run cajon-bridge)
VITE_CAJON_BRIDGE_URL=http://127.0.0.1:31415
